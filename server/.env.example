# ---------------------------------------------------------------------------
# Contact Group · Corporate Acquisition Portal — API configuration
#
# Copy to `.env` for local development. Every variable here is validated at
# boot by src/config/validation.ts — the process refuses to start if one is
# missing or malformed, rather than failing later under load.
#
# NEVER commit a real .env. In production these come from the secret store
# (Azure Key Vault / AWS Secrets Manager), not from a file on disk.
# ---------------------------------------------------------------------------

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Mounted under this prefix; routes are additionally versioned as /api/v1/...
API_PREFIX=api

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=portal
DB_PASSWORD=portal_local_password
DB_NAME=acquisition_portal
DB_SCHEMA=public
DB_SSL=false
# Pool sizing: keep (POOL_MAX × instances) below Postgres max_connections.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
# Query logging: 'none' | 'error' | 'all'. Use 'error' in production.
DB_LOGGING=error
# Warn on any query slower than this (ms).
DB_SLOW_QUERY_MS=500

# --- JWT ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Access and refresh MUST use different secrets so a leaked access-token
# secret cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=contact-acquisition-portal
JWT_AUDIENCE=contact-acquisition-portal-web

# --- Password policy ------------------------------------------------------
# Argon2id parameters. Raise memory/time on stronger hardware; measure first —
# target roughly 250-500ms per hash on production instances.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12

# --- Brute-force protection ----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --- HTTP security --------------------------------------------------------
# Comma-separated exact origins. Never '*' outside local development.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
# Request body ceiling. Raise only for the file-upload module, per-route.
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
# Set true when running behind a load balancer / reverse proxy so that
# req.ip reflects X-Forwarded-For rather than the proxy's address.
TRUST_PROXY=false

# --- Rate limiting --------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Stricter bucket applied to /auth/login and /auth/refresh.
THROTTLE_AUTH_TTL_SECONDS=300
THROTTLE_AUTH_LIMIT=10

# --- Cookies --------------------------------------------------------------
# The refresh token is delivered as an HttpOnly cookie; the access token is
# returned in the response body and held in memory by the SPA.
COOKIE_SECRET=change-me-dev-only-cookie-secret-at-least-32-chars
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Observability --------------------------------------------------------
# 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=debug
# Pretty-print logs locally; always false in production (ship NDJSON).
LOG_PRETTY=true

# --- API documentation ----------------------------------------------------
# Swagger is served at /docs. Keep this false in production unless the
# environment is network-isolated.
SWAGGER_ENABLED=true

# --- Seeding --------------------------------------------------------------
# Bootstrap administrator created by `npm run seed`. Change the password
# immediately after the first login; the account is flagged
# must_change_password so the API forces it.
SEED_ADMIN_EMAIL=admin@contact.eg
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Portal Administrator
SEED_ADMIN_PASSWORD=ChangeMe!Immediately1
